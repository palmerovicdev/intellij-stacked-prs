<idea-plugin>
    <!-- id, name, version e idea-version los inyecta Gradle desde gradle.properties. -->
    <vendor email="palmerodev@gmail.com">Victor Palmero</vendor>

    <description><![CDATA[
        <p>
            <b>Upstack</b> puts GitHub stacked pull requests inside the IDE. It is a visual
            front end for <a href="https://github.com/github/gh-stack">gh stack</a> and
            <code>gh pr</code>: every button runs the same command you would type in the
            terminal, so you can switch between the IDE and the terminal at any point.
        </p>
        <ul>
            <li><b>Stacks tool window</b>: the stack as a graph from the top layer down to the
                trunk, with each layer's pull request, draft or ready state, labels, review
                decision and CI status. <b>Back to Stacks</b> lists every local stack without
                changing branch.</li>
            <li><b>Start a stack</b>, <b>add a layer</b> on top (a new branch or an existing
                one, local or remote, optionally committing your changes), <b>publish</b> choosing layer by layer which pull requests are ready for
                review and the title of the new ones, a single layer from its menu, or in one go as <b>drafts</b>
                (<code>gh stack submit --auto</code>) or <b>ready for review</b>
                (<code>--open</code>, after showing which pull requests will change),
                <b>sync</b> and <b>rebase</b>, with conflict handling.</li>
            <li><b>Rebase upstack</b>: after a commit on a lower layer, carry it to the layers
                above without fetching or rebasing onto the trunk
                (<code>gh stack rebase --upstack --no-trunk</code>), offered right after the commit,
                from the <i>needs rebase</i> banner and from each layer. Then push the rebased
                branches in one click from the banner that stays until they are pushed
                (<code>gh stack push</code>). The first rebase asks whether to
                turn on <code>git rerere</code>, as gh stack does in the terminal.</li>
            <li><b>Guided conflicts</b>: when a rebase stops, the IDE's conflicts dialog opens on its
                own, and the stack says which layer and which commit stopped and how many files are
                still in conflict. When none is left, <b>Continue</b> is one click.</li>
            <li><b>Show Layer Changes</b>: the IDE diff with what a layer adds on top of the one
                below, the same changes its pull request shows. A pull request whose base on GitHub is
                not the layer below is marked <i>Wrong base</i>, and one click points it back.</li>
            <li><b>Merge a stack</b>, whole or up to a layer, with GitHub's atomic stack merge
                (<code>gh stack merge</code>): the dialog shows which pull requests go in, their
                review and CI, and the merge method the repository allows (the last one used is
                remembered). If the base uses a merge queue, they join the queue. Afterwards,
                <b>Sync and Prune</b> deletes the merged branches
                (<code>gh stack sync --prune</code>).</li>
            <li><b>Close a whole stack</b>: unstack it, close its open pull requests (with an
                optional comment) and delete its remote and local branches, in an order that
                never leaves a stack without branches behind.</li>
            <li><b>Labels</b>, <b>ready / draft</b>, the <b>title</b> and a <b>final-layer label</b>
                (<code>stack-final</code> by default) from the stack and from the
                <i>Pull Requests</i> tool window menus.</li>
            <li><b>When a branch goes missing</b>: a layer whose branch was deleted is marked, and
                <b>Restore Branch</b> brings it back from the remote or its last known commit, or
                <b>Remove From Stack</b> takes it out. Layers without a pull request can be
                <b>deleted</b> (the top one) or <b>renamed</b>, here and on GitHub.</li>
            <li>Every button, menu item and dialog option explains on hover what it does and the
                exact command it runs.</li>
            <li><b>Check</b> in Settings | Version Control | Upstack: which <code>gh</code> is used,
                the account on each host, the version of <code>gh-stack</code> and whether the
                repository supports stacked pull requests, with the fix next to whatever is
                missing. <b>Log In</b> signs in without a terminal
                (<code>gh auth login --web</code>): a dialog shows the one-time code and opens
                GitHub.</li>
            <li>A <b>Log</b> tab with every command and its output.</li>
        </ul>
        <p>Requires the <a href="https://cli.github.com">GitHub CLI</a>, signed in
            (<code>gh auth login</code>, or <i>Log In</i> from the plugin), and the
            <code>gh-stack</code> extension, v0.1.1 (the plugin offers to install it, and warns
            about any other version).</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <!-- La pila vive en un repositorio Git: sin Git4Idea no hay nada que mostrar. -->
    <depends>Git4Idea</depends>
    <!-- Solo para los menus de la ventana Pull Requests. Sin el plugin GitHub, todo lo demas
         funciona igual. -->
    <depends optional="true" config-file="upstack-github.xml">org.jetbrains.plugins.github</depends>

    <resource-bundle>messages.UpstackBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="Upstack"
                    anchor="right"
                    icon="/icons/upstack.svg"
                    factoryClass="com.upstack.ui.StackToolWindowFactory"/>
        <notificationGroup id="Upstack" displayType="BALLOON" key="notification.group"/>
        <!-- Tras un commit en una capa intermedia, ofrecer el rebase upstack. -->
        <checkinHandlerFactory implementation="com.upstack.stack.RestackCheckinHandlerFactory"/>
        <!-- Junto a Git y GitHub, en Version Control. Solo hay paginas de proyecto en ese grupo;
             los ajustes siguen siendo globales (UpstackSettings). -->
        <projectConfigurable parentId="project.propVCSSupport.Mappings"
                             id="com.upstack.settings"
                             instance="com.upstack.settings.UpstackConfigurable"
                             key="settings.title"/>
    </extensions>

    <projectListeners>
        <listener class="com.upstack.stack.GitEvents" topic="git4idea.repo.GitRepositoryChangeListener"/>
        <listener class="com.upstack.stack.GitEvents" topic="com.intellij.dvcs.repo.VcsRepositoryMappingListener"/>
        <listener class="com.upstack.stack.GitEvents" topic="com.intellij.openapi.vcs.changes.ChangeListListener"/>
    </projectListeners>

    <actions resource-bundle="messages.UpstackBundle">
        <group id="Upstack.Toolbar">
            <action id="Upstack.ShowStackList" class="com.upstack.actions.ShowStackListAction"/>
            <action id="Upstack.Refresh" class="com.upstack.actions.RefreshAction"/>
            <separator/>
            <action id="Upstack.InitStack" class="com.upstack.actions.InitStackAction"/>
            <action id="Upstack.AddLayer" class="com.upstack.actions.AddLayerAction"/>
            <separator/>
            <action id="Upstack.Publish" class="com.upstack.actions.PublishStackAction"/>
            <action id="Upstack.PublishDraft" class="com.upstack.actions.PublishDraftAction"/>
            <action id="Upstack.PublishReady" class="com.upstack.actions.PublishReadyAction"/>
            <separator/>
            <action id="Upstack.Sync" class="com.upstack.actions.SyncAction"/>
            <!-- Upstack primero: es lo que se quiere tras tocar una capa intermedia. -->
            <group id="Upstack.RebaseMenu" class="com.upstack.actions.RebaseGroup" popup="true" icon="AllIcons.Vcs.Merge">
                <action id="Upstack.RebaseUpstack" class="com.upstack.actions.RebaseUpstackAction"/>
                <action id="Upstack.Rebase" class="com.upstack.actions.RebaseAction"/>
                <action id="Upstack.RebaseDownstack" class="com.upstack.actions.RebaseDownstackAction"/>
                <action id="Upstack.RebaseLayers" class="com.upstack.actions.RebaseLayersAction"/>
            </group>
            <separator/>
            <action id="Upstack.MergeStack" class="com.upstack.actions.MergeStackAction"/>
            <action id="Upstack.CloseStack" class="com.upstack.actions.CloseStackAction"/>
            <separator/>
            <action id="Upstack.OpenSettings" class="com.upstack.actions.OpenSettingsAction"/>
        </group>

        <!-- Las acciones de PR sirven en los dos sitios: aqui y en los menus de Pull Requests
             (upstack-github.xml). Cada una resuelve su PR segun donde se abra el menu. -->
        <action id="Upstack.MarkReady" class="com.upstack.actions.MarkReadyAction"/>
        <action id="Upstack.MarkDraft" class="com.upstack.actions.MarkDraftAction"/>
        <action id="Upstack.EditTitle" class="com.upstack.actions.EditTitleAction"/>
        <action id="Upstack.EditLabels" class="com.upstack.actions.EditLabelsAction"/>
        <action id="Upstack.ToggleFinal" class="com.upstack.actions.ToggleFinalAction"/>

        <!-- Clic derecho sobre una fila: solo lo de esa capa (o esa pila local), nada con «Stack».
             Lo de la pila entera esta en Upstack.Stack.Popup, fuera de las filas. -->
        <group id="Upstack.Layer.Popup">
            <!-- Solo sobre una pila local cuyas ramas ya no existen. -->
            <action id="Upstack.RecreateStack" class="com.upstack.actions.RecreateStackAction"/>
            <action id="Upstack.ForgetStack" class="com.upstack.actions.ForgetStackAction"/>
            <!-- Solo sobre una capa cuya rama ya no existe en local. -->
            <action id="Upstack.RestoreBranch" class="com.upstack.actions.RestoreBranchAction"/>
            <action id="Upstack.RemoveFromStack" class="com.upstack.actions.RemoveFromStackAction"/>
            <action id="Upstack.CheckoutLayer" class="com.upstack.actions.CheckoutLayerAction"/>
            <action id="Upstack.ShowLayerChanges" class="com.upstack.actions.ShowLayerChangesAction"/>
            <action id="Upstack.OpenPr" class="com.upstack.actions.OpenPrAction"/>
            <!-- Solo en una capa sin PR: publicarla a ella, no la pila (eso es Publish Stack…, fuera de las filas). -->
            <action id="Upstack.PublishLayerDraft" class="com.upstack.actions.PublishLayerDraftAction"/>
            <action id="Upstack.PublishLayerReady" class="com.upstack.actions.PublishLayerReadyAction"/>
            <action id="Upstack.CopyPrLink" class="com.upstack.actions.CopyPrLinkAction"/>
            <separator/>
            <action id="Upstack.RebaseUpstackFromLayer" class="com.upstack.actions.RebaseUpstackFromLayerAction"/>
            <!-- Solo en una capa sin PR; con PR, desactivada y diciendo por que. -->
            <action id="Upstack.RenameBranch" class="com.upstack.actions.RenameBranchAction"/>
            <!-- Solo en la capa de arriba sin PR. -->
            <action id="Upstack.DeleteLayer" class="com.upstack.actions.DeleteLayerAction"/>
            <!-- Solo si el PR apunta en GitHub a otra rama que la capa de debajo. -->
            <action id="Upstack.ChangePrBase" class="com.upstack.actions.ChangePrBaseAction"/>
            <separator/>
            <action id="Upstack.MergeUpToLayer" class="com.upstack.actions.MergeUpToLayerAction"/>
            <separator/>
            <reference ref="Upstack.MarkReady"/>
            <reference ref="Upstack.MarkDraft"/>
            <separator/>
            <reference ref="Upstack.EditTitle"/>
            <reference ref="Upstack.EditLabels"/>
            <reference ref="Upstack.ToggleFinal"/>
        </group>

        <!-- Clic derecho fuera de las filas o sobre la base: la pila entera, por eso dicen «Stack». -->
        <group id="Upstack.Stack.Popup">
            <reference ref="Upstack.AddLayer"/>
            <reference ref="Upstack.Publish"/>
            <reference ref="Upstack.PublishDraft"/>
            <reference ref="Upstack.PublishReady"/>
            <separator/>
            <reference ref="Upstack.MergeStack"/>
            <reference ref="Upstack.CloseStack"/>
        </group>
    </actions>
</idea-plugin>
